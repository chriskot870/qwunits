{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "arm64-debug",
            "displayName": "Arm 64 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/arm64-debug",
            "toolchainFile": "${sourceDir}/cmake/arm64_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/x64-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "arm64-release",
            "displayName": "Arm 64 Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/arm64-release",
            "toolchainFile": "${sourceDir}/cmake/arm64_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug"
        },
        {
            "name": "arm64-debug",
            "configurePreset": "arm64-debug"
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release"
        },
        {
            "name": "arm64-release",
            "configurePreset": "arm64-release"
        }
    ]
}