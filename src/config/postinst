#!/bin/bash

QW_INSTALL_DIR="/usr/lib/qw"
QW_UNITS_INSTALL_DIR="$QW_INSTALL_DIR/units"
QW_UNITS_LIB_DIR="$QW_UNITS_INSTALL_DIR/lib"
QW_LD_SO_CONF_FILE="/etc/ld.so.conf.d/linux-qw.conf"

# Make sure the shared library file exists
SHARED_LIBS_CNT=`find QW_UNITS_LIB_DIR -maxdepth 1 -type f -name "\*\.so" | wc -l`
if [ $SHARED_LIBS_CNT -gt 0 ]; then
  # Check if the ld.so.conf file exists
  if [ ! -f $QW_LD_SO_CONF_FILE ]; then
    # The file doesn't exist so create it
    echo # This file is automatically generated by qw packages at installation time
    echo $QW_UNITS_LIB_DIR > $QW_LD_SO_CONF_FILE
  else
    # The file does exist so make sure there is an entry for the unit library paths
    ENTRY_CNT=`grep -c $QW_UNITS_LIB_DIR $QW_LD_SO_CONF_FILE`
    if [ $ENTRY_CNT -eq 0 ]; then
      sed -i "\$a\\$QW_UNITS_LIB_DIR" $QW_LD_SO_CONF_FILE
    fi
  fi
fi
# We know that the path exists in the file so run ld.config to register it
ld.config
